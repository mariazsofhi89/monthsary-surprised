<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy 1st Monthsary My Love</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Quicksand:wght@500;600;700&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Fredoka', 'Quicksand', sans-serif;
        }

        body {
            background-color: #ffe6ee;
            background-image: 
                radial-gradient(#ffb6c1 15%, transparent 16%),
                radial-gradient(#ffccd5 15%, transparent 16%);
            background-size: 30px 30px;
            background-position: 0 0, 15px 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            overflow-x: hidden;
        }

        .screen {
            display: none;
            width: 100%;
            max-width: 520px;
            background: #ffffff;
            border-radius: 35px;
            border: 4px solid #ff9ebb;
            box-shadow: 0 15px 30px rgba(255, 158, 187, 0.3);
            padding: 30px 25px;
            position: relative;
            overflow: hidden;
            text-align: center;
            animation: fadeIn 0.5s ease-in-out;
        }

        .screen.active {
            display: block;
        }

        .header-ribbon {
            background: #ff85a1;
            color: #ffffff;
            display: inline-block;
            padding: 8px 25px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            box-shadow: 0 5px 12px rgba(255, 133, 161, 0.3);
            margin-bottom: 15px;
            border: 2px solid #ffffff;
        }

        .title {
            color: #ff477e;
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #ff9ebb;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        /* Password Input Box */
        .pass-box {
            margin: 20px 0;
        }

        .pass-input {
            width: 80%;
            padding: 12px;
            border: 3px solid #ff9ebb;
            border-radius: 20px;
            text-align: center;
            font-size: 18px;
            font-weight: 700;
            color: #ff477e;
            outline: none;
            letter-spacing: 4px;
        }

        .pass-input:focus {
            border-color: #ff477e;
        }

        .error-msg {
            color: #ff3366;
            font-size: 12px;
            font-weight: 600;
            margin-top: 8px;
            display: none;
        }

        /* Question Buttons */
        .btn-group {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
        }

        .btn {
            background: #ff85a1;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 25px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 6px 0 #ff477e;
            transition: all 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 0 #ff477e;
        }

        .btn:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #ff477e;
        }

        .btn:disabled {
            background: #ffd1dc;
            box-shadow: 0 6px 0 #fca3b7;
            cursor: not-allowed;
            transform: none;
        }

        /* Slides Styling */
        .slides-container {
            position: relative;
            min-height: 380px;
        }

        .slide {
            display: none;
            background: #fff8fa;
            border: 3px dashed #ffb6c1;
            border-radius: 25px;
            padding: 28px 22px;
            animation: kawaiiPop 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            position: relative;
        }

        .slide.active {
            display: block;
        }

        .slide-badge {
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            background: #ffe6ed;
            color: #ff477e;
            border: 2px solid #ff85a1;
            padding: 3px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .slide-text {
            color: #5a4b51;
            font-size: 14.5px;
            line-height: 1.8;
            text-align: justify;
            margin-top: 10px;
            font-family: 'Quicksand', sans-serif;
            font-weight: 600;
        }

        .corner-decor {
            position: absolute;
            width: 14px;
            height: 14px;
            background: #ffb6c1;
            border-radius: 50%;
        }

        .top-left { top: 12px; left: 12px; }
        .top-right { top: 12px; right: 12px; }
        .bottom-left { bottom: 12px; left: 12px; }
        .bottom-right { bottom: 12px; right: 12px; }

        .nav-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 25px;
            padding: 0 10px;
        }

        .slide-dots {
            display: flex;
            gap: 8px;
        }

        .dot {
            width: 12px;
            height: 12px;
            background: #ffd1dc;
            border-radius: 50%;
            transition: all 0.3s ease;
        }

        .dot.active {
            background: #ff477e;
            width: 24px;
            border-radius: 10px;
        }

        /* Falling Flowers */
        .flower {
            position: fixed;
            top: -20px;
            font-size: 22px;
            user-select: none;
            pointer-events: none;
            animation: fall 3s linear forwards;
            z-index: 999;
        }

        @keyframes fall {
            to {
                transform: translateY(105vh) rotate(360deg);
                opacity: 0;
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        @keyframes kawaiiPop {
            0% { opacity: 0; transform: scale(0.9) translateY(15px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }
    </style>
</head>
<body>

    <!-- SCREEN 1: PASSWORD LOCK -->
    <div class="screen active" id="screenLock">
        <div class="header-ribbon">Happy 1st Monthsary My Love</div>
        <h1 class="title">Secret Passcode Required</h1>
        <p class="subtitle">Please enter the passcode to unlock my love letter!</p>
        <div class="pass-box">
            <input type="password" id="passInput" class="pass-input" placeholder="••••••" maxlength="6">
            <div class="error-msg" id="errorMsg">Incorrect passcode! Try again baby.</div>
        </div>
        <button class="btn" onclick="checkPassword()">Unlock</button>
    </div>

    <!-- SCREEN 2: DO U WANT TO OPEN QUESTION -->
    <div class="screen" id="screenQuestion">
        <div class="header-ribbon">Happy 1st Monthsary My Love</div>
        <h1 class="title">do u want to open</h1>
        <p class="subtitle">I prepared a special message just for you!</p>
        <div class="btn-group">
            <button class="btn" onclick="startFlowerSurprise()">Yes</button>
            <button class="btn" id="noBtn" onclick="noClicked()">No</button>
        </div>
    </div>

    <!-- SCREEN 3: LOVE LETTER SLIDES -->
    <div class="screen" id="screenLetter">
        <div class="header-ribbon">Happy 1st Monthsary My Love</div>
        <h1 class="title">Happy 1st Monthsary</h1>
        <p class="subtitle">Click Next to read my letter, Baby!</p>

        <div class="slides-container">
            
            <!-- SLIDE 1 -->
            <div class="slide active" id="slide1">
                <div class="corner-decor top-left"></div>
                <div class="corner-decor top-right"></div>
                <div class="slide-badge">Part 1 of 3</div>
                <p class="slide-text">
                    Happy 1st monthsary baby, thank you baby because you came into my life, when you arrived everything changed and my happiness came back, you are the only one I want to be with for the rest of my life and no one else, you are the only one I will love no matter what happens, you are the only handsome guy in my eyes which is why I love you so much because you have everything I want in a man your understanding nature and you are so kind plus you are so gentlemanly to me it makes me fall in love with you even more baby, I have nothing more to ask for except you, also even when I get upset with you you never leave and you ask me first if I want space whenever we have a misunderstanding, that is why I love you so much because you never get mad at me and you never get tired of me even when I am moody towards you and you are not a toxic boyfriend, thank you baby for treating me right I am so very happy because you came into my life I hope baby we last forever and not just a hope but a real forever together for life until death.
                </p>
                <div class="corner-decor bottom-left"></div>
                <div class="corner-decor bottom-right"></div>
            </div>

            <!-- SLIDE 2 -->
            <div class="slide" id="slide2">
                <div class="corner-decor top-left"></div>
                <div class="corner-decor top-right"></div>
                <div class="slide-badge">Part 2 of 3</div>
                <p class="slide-text">
                    I love everything about you including your smile and your face as well as your voice which shines so brightly I love it so much along with your hands and your lips, you know baby I am also so lucky to have you baby so I hope nothing changes between us I want you to feel all the love I have to give, you are such a caring boyfriend, I thought I was just dreaming but it turned out to be real because I am so lucky with the princess treatment you give me which I know is not like others baby, thank you for introducing me to your family, thank you by the way for making us official to them baby I love you.
                </p>
                <div class="corner-decor bottom-left"></div>
                <div class="corner-decor bottom-right"></div>
            </div>

            <!-- SLIDE 3 -->
            <div class="slide" id="slide3">
                <div class="corner-decor top-left"></div>
                <div class="corner-decor top-right"></div>
                <div class="slide-badge">Part 3 of 3</div>
                <p class="slide-text">
                    There is no perfect person baby right which is why for me you are perfect because we are a perfect match, I promise you I will make you happy for the rest of my life forever baby, I will not break my promise to you, this is truly real, I really love you so much, thank you baby for loving me so much more than I ever expected, I love you so much my baby.
                </p>
                <div class="corner-decor bottom-left"></div>
                <div class="corner-decor bottom-right"></div>
            </div>

        </div>

        <div class="nav-controls">
            <button class="btn" id="prevBtn" onclick="changeSlide(-1)" disabled>Back</button>
            <div class="slide-dots">
                <div class="dot active" id="dot1"></div>
                <div class="dot" id="dot2"></div>
                <div class="dot" id="dot3"></div>
            </div>
            <button class="btn" id="nextBtn" onclick="changeSlide(1)">Next</button>
        </div>
    </div>

    <script>
        const correctPass = "080326";

        function checkPassword() {
            const input = document.getElementById('passInput').value;
            const errorMsg = document.getElementById('errorMsg');
            
            if (input === correctPass) {
                errorMsg.style.display = 'none';
                document.getElementById('screenLock').classList.remove('active');
                document.getElementById('screenQuestion').classList.add('active');
            } else {
                errorMsg.style.display = 'block';
            }
        }

        function noClicked() {
            const noBtn = document.getElementById('noBtn');
            noBtn.innerText = "Yes!";
            noBtn.onclick = startFlowerSurprise;
        }

        function startFlowerSurprise() {
            for (let i = 0; i < 40; i++) {
                setTimeout(() => {
                    createFlower();
                }, i * 50);
            }

            setTimeout(() => {
                document.getElementById('screenQuestion').classList.remove('active');
                document.getElementById('screenLetter').classList.add('active');
            }, 1200);
        }

        function createFlower() {
            const flower = document.createElement('div');
            flower.classList.add('flower');
            
            const flowerIcons = ['🌸', '🌺', '🌹', '✨', '💖'];
            flower.innerText = flowerIcons[Math.floor(Math.random() * flowerIcons.length)];
            
            flower.style.left = Math.random() * 100 + 'vw';
            flower.style.animationDuration = (Math.random() * 2 + 2) + 's';
            
            document.body.appendChild(flower);
            
            setTimeout(() => {
                flower.remove();
            }, 3000);
        }

        let currentSlide = 1;
        const totalSlides = 3;

        function changeSlide(direction) {
            document.getElementById(`slide${currentSlide}`).classList.remove('active');
            document.getElementById(`dot${currentSlide}`).classList.remove('active');

            currentSlide += direction;

            document.getElementById(`slide${currentSlide}`).classList.add('active');
            document.getElementById(`dot${currentSlide}`).classList.add('active');

            document.getElementById('prevBtn').disabled = (currentSlide === 1);
            
            if (currentSlide === totalSlides) {
                document.getElementById('nextBtn').innerText = 'Love You!';
                document.getElementById('nextBtn').disabled = true;
            } else {
                document.getElementById('nextBtn').innerText = 'Next';
                document.getElementById('nextBtn').disabled = false;
            }
        }
    </script>
</body>
</html>
